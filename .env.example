# Copia este archivo a .env para configurar el entorno local.
# Completa los valores privados con las credenciales de TU rama de Neon.
# Nunca publiques .env ni copies sus secretos a config.js.

DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST-POOLER/moyo?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USUARIO:CONTRASENA@HOST-DIRECTO/moyo?sslmode=require

# URLs públicas de Neon Auth. Deben pertenecer al entorno de la base de datos.
NEON_AUTH_BASE_URL=https://TU_HOST_DE_AUTH/moyo/auth
NEON_AUTH_JWKS_URL=https://TU_HOST_DE_AUTH/moyo/auth/.well-known/jwks.json

# Define una clave propia larga y aleatoria; activa una sola cuenta propietaria.
OWNER_SETUP_TOKEN=REEMPLAZAR_POR_UNA_CLAVE_PRIVADA_LARGA_Y_ALEATORIA

# Sin barra final. Agrega otros orígenes sólo cuando correspondan a tu interfaz.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
